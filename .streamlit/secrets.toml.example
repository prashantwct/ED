# Copy to secrets.toml and fill in. On Streamlit Cloud, set these in
# Manage app -> Settings -> Secrets instead of committing a file.
#
# MapTiler basemap key. Tiles are fetched by the browser, so this key is
# always visible to anyone using the app - it cannot be kept secret.
# Restrict it by origin in the MapTiler dashboard (Keys -> Allowed origins)
# so it only works from your deployment's domain.
MAPTILER_KEY = "your-maptiler-key"

# Epicollect5, only if the damage projects are made private. The project's
# creator or manager makes a client app on the project details page; the
# public projects need neither line.
# EPICOLLECT_CLIENT_ID = "123"
# EPICOLLECT_CLIENT_SECRET = "client-secret"
