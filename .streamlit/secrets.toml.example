# Copy to secrets.toml and fill in. On Streamlit Cloud, set these in
# Manage app -> Settings -> Secrets instead of committing a file.
#
# MapTiler basemap key. Tiles are fetched by the browser, so this key is
# always visible to anyone using the app - it cannot be kept secret.
# Restrict it by origin in the MapTiler dashboard (Keys -> Allowed origins)
# so it only works from your deployment's domain.
MAPTILER_KEY = "your-maptiler-key"

# Epicollect5 damage projects, when they are private. A client app opens
# only the project it is made in, so each project has its own pair: on
# five.epicollect.net open the project -> Details -> Apps -> Add app (creator
# or manager only), then copy its Client ID and Client Secret here.
# EPICOLLECT_HERD_CROP_DAMAGE_CLIENT_ID = "123"
# EPICOLLECT_HERD_CROP_DAMAGE_CLIENT_SECRET = "client-secret"
# EPICOLLECT_HERD_HOUSE_DAMAGE_CLIENT_ID = "456"
# EPICOLLECT_HERD_HOUSE_DAMAGE_CLIENT_SECRET = "client-secret"
